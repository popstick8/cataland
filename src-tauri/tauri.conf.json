{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Cataland",
	"version": "../package.json",
	"identifier": "build.loop.cataland",
	"build": {
		"beforeDevCommand": "pnpm web",
		"beforeBuildCommand": "pnpm build",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Cataland",
				"width": 1440,
				"height": 960,
				"minWidth": 960,
				"minHeight": 640
			}
		]
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/icon.png"]
	}
}
