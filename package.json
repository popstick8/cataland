{
	"name": "cataland",
	"version": "1.0.0",
	"description": "A tabletop island strategy game for local networks.",
	"scripts": {
		"dev": "tauri dev",
		"web": "vite",
		"build": "tsc && vite build",
		"check": "biome check --write --error-on-warnings && tsc && cargo fmt && cargo clippy --workspace --all-targets -- -D warnings",
		"desktop": "tauri build",
		"bindings": "cargo run -p cataland-core --bin bindings && biome format --write ."
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.4.1",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.4.1",
	"type": "module",
	"dependencies": {
		"@tauri-apps/api": "^2.11.1",
		"lucide-react": "^1.44.0",
		"pixi.js": "^8.20.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^26.5.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.0"
	},
	"private": true
}
